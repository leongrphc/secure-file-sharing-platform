{
  "name": "secure-file-sharing-platform", "private": true, "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w @sfs/api' 'npm run dev -w @sfs/web'",
    "lint": "eslint .", "typecheck": "npm run typecheck --workspaces", "build": "npm run build --workspaces",
    "test": "vitest run", "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test", "db:migrate": "npm run db:migrate -w @sfs/api",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {"@eslint/js":"^9.39.0","eslint":"^9.39.0","typescript-eslint":"^8.46.0","typescript":"^5.9.3","concurrently":"^9.2.1","vitest":"^3.2.4","supertest":"^7.1.4","@types/supertest":"^6.0.3","@playwright/test":"^1.56.0","dotenv":"^17.2.3"}
}
