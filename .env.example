# Run npm run setup to generate local-only secrets into .env (never committed).
DATABASE_URL=postgresql://sfs:local_only_password@localhost:55473/sfs
REDIS_URL=redis://localhost:56373
APP_ORIGIN=http://localhost:33073
PORT=34073
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
MASTER_KEY=
SIGNING_KEY=
S3_ENDPOINT=http://localhost:39073
S3_REGION=us-east-1
S3_BUCKET=private-files
S3_ACCESS_KEY=local_minio
S3_SECRET_KEY=
COOKIE_SECURE=false
DEMO_ENABLED=true

# Vercel deployment: API uses private Blob storage with a 4 MiB transfer limit.
# STORAGE_DRIVER=vercel-blob
# MAX_FILE_BYTES=4194304
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# API_GATEWAY_SECRET=
# Web project (server-side gateway secret must match API):
# API_INTERNAL_URL=https://your-api.vercel.app
# NEXT_PUBLIC_MAX_FILE_BYTES=4194304
