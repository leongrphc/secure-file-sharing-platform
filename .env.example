# Run npm run setup to generate local-only secrets into .env (never committed).
DATABASE_URL=postgresql://sfs:local_only_password@localhost:5432/sfs
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3000
PORT=4000
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../.local-storage
MASTER_KEY=
SIGNING_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=private-files
S3_ACCESS_KEY=local_minio
S3_SECRET_KEY=
COOKIE_SECURE=false
DEMO_ENABLED=true
